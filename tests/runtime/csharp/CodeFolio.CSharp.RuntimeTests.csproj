<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <Target Name="GenerateSnippetTests" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GeneratedSnippetTests>$(IntermediateOutputPath)SnippetTests.g.cs</GeneratedSnippetTests>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="node generate-tests.mjs &quot;$(GeneratedSnippetTests)&quot;" />
    <ItemGroup>
      <Compile Include="$(GeneratedSnippetTests)" />
    </ItemGroup>
  </Target>
</Project>
